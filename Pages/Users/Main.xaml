<Page x:Class="pr29_bartova.Pages.Users.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr29_bartova.Pages.Users"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <Button Content="Клубы" Background="#FF46FD00" Foreground="White" BorderThickness="0" 
                    Padding="15,5" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="Пользователи" Background="#FF46FD00" Foreground="White" BorderThickness="0" 
                    Padding="15,5" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Row="1" Background="#FFF0F0F0">
            <ScrollViewer Margin="0,0,0,50">
                <StackPanel x:Name="Parent"/>
            </ScrollViewer>
            <Button x:Name="BtnAdd"
                    Click="AddUser"
                    Height="25"
                    Content="Добавить"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    HorizontalAlignment="Right"
                    Width="100"
                    Background="#FF46FD00"
                    Foreground="White"/>
        </Grid>
    </Grid>
</Page>