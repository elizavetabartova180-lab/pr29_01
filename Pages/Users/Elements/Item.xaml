<UserControl x:Class="pr29_bartova.Pages.Users.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pr29_bartova.Pages.Users.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
             Margin="5">
    <Grid Background="White" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Image Source="/Images/ic_man.png" Width="80" Height="80" Margin="0,0,0,10"/>
            <Button x:Name="BtnEdit" Click="EditUser" Content="Изменить" 
                    Background="#39FF14" Foreground="White" BorderThickness="0" 
                    Padding="10,5" Margin="0,0,0,5" Cursor="Hand"/>
            <Button x:Name="BtnDelete" Click="DeleteUser" Content="Удалить" 
                    Background="#FF3939" Foreground="White" BorderThickness="0" 
                    Padding="10,5" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="Дата аренды:" Margin="0,0,0,5"/>
                <DatePicker x:Name="RentStart" Height="25"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                <TextBlock Text="Продолжительность:" Margin="0,0,0,5"/>
                <TextBox x:Name="Duration" Height="25" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="Время аренды:" Margin="0,0,0,5"/>
                <TextBox x:Name="RentTime" Height="25" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                <TextBlock Text="Клуб:" Margin="0,0,0,5"/>
                <TextBox x:Name="Club" Height="25" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBlock Text="Фамилия Имя и Отчество:" Margin="0,0,0,5"/>
                <TextBox x:Name="FIO" Height="25" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>