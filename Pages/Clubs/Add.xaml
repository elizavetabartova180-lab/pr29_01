<Page x:Class="pr29_bartova.Pages.Clubs.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr29_bartova.Pages.Clubs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                <Image Source="/Images/icons.png" Width="80" Height="80" Margin="0,0,0,20"/>
                <Button x:Name="BthAdd" Click="AddClub" Content="Добавить" Background="#FF46FD00" Foreground="White" BorderThickness="0" 
                        Padding="15,5" Cursor="Hand" HorizontalAlignment="Left"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,20,10">
                    <TextBlock Text="Наименование:" Margin="0,0,0,5"/>
                    <TextBox x:Name="Name" Width="250" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,20,0">
                    <TextBlock Text="Адрес:" Margin="0,0,0,5"/>
                    <TextBox x:Name="Address" Width="250" Height="25"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Время работы:" Margin="11,0,-11,5"/>
                <TextBox x:Name="WorkTime" Grid.Row="1" Height="80" 
                         TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Margin="10,0,53,0"/>
            </Grid>
        </Grid>
    </Grid>
</Page>